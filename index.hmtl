
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#030508">
<title>EditConnect | Skills Meet Opportunities</title>
<meta name="description" content="Prove your skills. Earn recognition. Discover your first professional opportunity.">

<style>
:root {
  --bg:#030508;
  --blue:#126BFF;
  --neon:#168BFF;
  --muted:#8fa3bf;
  --line:rgba(22,139,255,.28);
  --glass:rgba(10,20,38,.65);
}
*{box-sizing:border-box;margin:0}
html{background:var(--bg);color-scheme:dark;scroll-behavior:smooth}
body{color:white;font:16px/1.6 system-ui,sans-serif;overflow-x:hidden}
a{color:inherit;text-decoration:none}
button,input,textarea,select{font:inherit}
[hidden]{display:none!important}
.wrap{max-width:1040px;margin:auto;padding:0 24px}
.pg{padding-top:110px;padding-bottom:50px}
.narrow{max-width:600px}
.muted{color:var(--muted)}
.ptitle{font-size:clamp(1.8rem,5vw,2.6rem);margin-bottom:6px}
.sec{margin:28px 0 6px}

.lights{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.lights i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;background:radial-gradient(circle,rgba(18,107,255,.16),transparent 65%)}
.lights i:first-child{top:-25vmax;left:-15vmax}
.lights i:last-child{bottom:-30vmax;right:-20vmax}

.nav{
 position:fixed;top:0;left:0;right:0;z-index:20;
 display:flex;align-items:center;justify-content:space-between;
 padding:14px clamp(18px,4vw,48px);
 background:rgba(3,5,8,.9);
 backdrop-filter:blur(14px);
 border-bottom:1px solid rgba(22,139,255,.14)
}
.brand{font-weight:700;font-size:1.2rem;letter-spacing:.04em}
.menu{display:flex;align-items:center;gap:18px;color:var(--muted);font-size:.9rem}
.menu a:hover{color:white}
.menu .signin{color:white;border:1px solid var(--line);padding:8px 18px;border-radius:999px}
.burger{display:none;background:none;border:1px solid var(--line);color:white;padding:10px;border-radius:9px}

.hero{
 min-height:100svh;display:flex;flex-direction:column;
 align-items:center;justify-content:center;text-align:center;
 padding:120px 24px 80px
}
.logo{font-size:2.8rem;font-weight:800;color:var(--neon);text-shadow:0 0 30px #126bff;margin-bottom:30px}
h1{font-size:clamp(2.4rem,7vw,4.6rem);line-height:1.1;max-width:14ch}
.sub{max-width:34em;margin:20px 0 36px;color:var(--muted);font-size:1.1rem}
.actions{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}

.btn{
 display:inline-flex;align-items:center;justify-content:center;gap:10px;
 padding:14px 25px;border:1px solid var(--line);
 border-radius:999px;background:transparent;color:white;
 font-size:.9rem;font-weight:650;letter-spacing:.04em;
 cursor:pointer;transition:.2s
}
.btn:hover{transform:translateY(-2px);border-color:var(--neon)}
.btn:disabled{opacity:.5;cursor:wait;transform:none}
.btn.primary{background:var(--blue);border-color:transparent;box-shadow:0 0 22px rgba(22,139,255,.35)}
.btn.primary:hover{background:var(--neon)}
.btn.small{padding:10px 19px;font-size:.8rem}
.btn.google{width:100%;background:white;color:#222;border-color:#ddd;letter-spacing:0;margin-bottom:18px}
.btn.google:hover{background:#eee}
.google-icon{font-weight:800;font-size:1.1rem;color:#4285F4}

.feature{
 display:block;margin-top:16px;padding:28px;
 border:1px solid var(--line);border-radius:20px;
 background:var(--glass);transition:.25s
}
.feature:hover{border-color:var(--neon);box-shadow:0 0 25px rgba(22,139,255,.15)}
.feature h2,.feature h3{margin:12px 0 8px}
.feature p{color:var(--muted);margin-bottom:8px}
.lead{padding:45px;border-color:rgba(22,139,255,.6)}
.lead h2{font-size:2.5rem}
.tag{display:inline-block;margin:0 4px 4px 0;padding:3px 12px;border:1px solid var(--line);border-radius:999px;color:var(--neon);font-size:.78rem}
.hot{background:var(--blue);color:white}
.meta{font-size:.88rem}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}
.grid .feature{margin:0}

.panel{
 width:100%;margin:16px 0;padding:clamp(22px,4vw,36px);
 border:1px solid var(--line);border-radius:22px;
 background:var(--glass);backdrop-filter:blur(14px)
}
.panel h2{margin-bottom:16px;font-size:1.8rem}
.field{display:block;margin-bottom:16px;color:var(--muted);font-size:.85rem}
.field input,.field textarea,.field select{
 display:block;width:100%;margin-top:6px;padding:13px 16px;
 border:1px solid var(--line);border-radius:12px;
 background:rgba(3,5,8,.8);color:white
}
.field textarea{min-height:90px;resize:vertical}
.field input:focus,.field textarea:focus,.field select:focus{outline:1px solid var(--neon)}
.roles label{display:block;margin-bottom:10px;cursor:pointer}
.roles input{margin-right:8px}
.roles span{color:white}
.check{display:flex;align-items:center;gap:10px;margin-bottom:16px;color:var(--muted)}
.sw{margin-top:18px;font-size:.9rem;color:var(--muted)}
.sw a{color:var(--neon)}
.bar{height:8px;margin:14px 0;border-radius:99px;background:rgba(22,139,255,.15);overflow:hidden}
.bar i{display:block;height:100%;background:var(--neon)}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid rgba(22,139,255,.14)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin:18px 0}
.stats div{padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--glass)}
.stats b{display:block;font-size:1.8rem}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:28px;border-top:1px solid var(--line);color:var(--muted);font-size:.8rem}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:50;max-width:90vw;padding:13px 20px;border:1px solid var(--neon);border-radius:12px;background:#07101f}

@media(max-width:900px){.grid{grid-template-columns:1fr}}
@media(max-width:980px){
 .burger{display:block}
 .menu{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;padding:12px 20px;background:#030508;border-bottom:1px solid var(--line)}
 .menu.open{display:flex}
 .menu a{padding:12px;border-bottom:1px solid rgba(22,139,255,.1)}
 .menu .signin{text-align:center;margin-top:10px}
}
@media(prefers-reduced-motion:reduce){
 *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>
</head>

<body>
<div class="lights"><i></i><i></i></div>

<header class="nav">
 <a class="brand" href="#/home">EditConnect</a>
 <button class="burger" id="burger" aria-expanded="false" aria-label="Toggle menu">☰</button>
 <nav class="menu" id="menu">
  <a href="#/opps">Opportunities</a>
  <a href="#/first">First Client</a>
  <a href="#/match">Matches</a>
  <a href="#/cert">Certification</a>
  <a href="#/progress">Progress</a>
  <a href="#/profile">Profile</a>
  <a href="#/auth" id="acct" class="signin">Sign in</a>
 </nav>
</header>

<main id="view"></main>

<footer class="foot">
 <span>© 2026 EditConnect</span>
 <span>Skills Meet Opportunities.</span>
</footer>

<div id="toast" role="status" hidden></div>

<script type="module">

// ==========================================
// FIREBASE CONNECTION
// ==========================================

import { initializeApp }
from "https://www.gstatic.com/firebasejs/13.3.0/firebase-app.js";

import {
 getAuth,
 onAuthStateChanged,
 createUserWithEmailAndPassword,
 signInWithEmailAndPassword,
 signOut,
 sendPasswordResetEmail,
 GoogleAuthProvider,
 signInWithPopup
} from "https://www.gstatic.com/firebasejs/13.3.0/firebase-auth.js";

import {
 getFirestore,
 doc,
 getDoc,
 setDoc,
 addDoc,
 deleteDoc,
 collection,
 query,
 where,
 orderBy,
 limit,
 getDocs,
 serverTimestamp
} from "https://www.gstatic.com/firebasejs/13.3.0/firebase-firestore.js";

const firebaseConfig = {
 apiKey: "AIzaSyDl8rk3KAYc4-AiNAUvAkeoAPopfRI8tm4",
 authDomain: "editconnect-77505.firebaseapp.com",
 projectId: "editconnect-77505",
 storageBucket: "editconnect-77505.firebasestorage.app",
 messagingSenderId: "279328250493",
 appId: "1:279328250493:web:85b70045215e737523ef14",
 measurementId: "G-1CE19J0EQG"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const googleProvider = new GoogleAuthProvider();

// ==========================================
// COMMON FUNCTIONS
// ==========================================

const $ = s => document.querySelector(s);
const view = $("#view");
const menu = $("#menu");
const burger = $("#burger");

let me = null;
let mode = "in";
let busy = false;

const roles = [
 "Student / Beginner Freelancer",
 "Experienced Freelancer",
 "Client"
];

const esc = s => String(s ?? "").replace(/[&<>"']/g,c=>({
 "&":"&amp;",
 "<":"&lt;",
 ">":"&gt;",
 '"':"&quot;",
 "'":"&#39;"
}[c]));

const list = s => [...new Set(
 (s || "").split(",").map(x=>x.trim()).filter(Boolean)
)].slice(0,12);

const safe = u => /^https?:\/\//i.test(u || "") ? u : "";

const low = a => (a || []).map(x=>x.toLowerCase());

const isClient = () => me?.role === "Client";

const toast = message => {
 const el = $("#toast");
 el.textContent = message;
 el.hidden = false;
 clearTimeout(toast.timer);
 toast.timer = setTimeout(()=>el.hidden=true,4500);
};

const errors = {
 "auth/invalid-credential":"Incorrect email or password.",
 "auth/invalid-email":"Invalid email address.",
 "auth/email-already-in-use":"This email already has an account.",
 "auth/weak-password":"Password must contain at least 6 characters.",
 "auth/too-many-requests":"Too many attempts. Please wait.",
 "auth/network-request-failed":"Check your internet connection.",
 "auth/popup-closed-by-user":"Google sign-in was cancelled.",
 "auth/unauthorized-domain":"This website domain is not authorized in Firebase.",
 "permission-denied":"Database permission denied. Check Firestore rules."
};

const why = e => errors[e.code] || e.message || "Something went wrong.";

const paint = () => {
 const a = $("#acct");
 a.textContent = me ? "Sign out" : "Sign in";
 a.href = me ? "#/out" : "#/auth";
};

const page = (title,subtitle,body) => `
<div class="wrap pg">
 <h2 class="ptitle">${title}</h2>
 <p class="muted">${subtitle}</p>
 ${body}
</div>`;

const gate = title => page(
 title,
 "Create a free account or sign in to continue.",
 '<a class="btn primary" href="#/auth">SIGN IN →</a>'
);

const tags = a => (a || []).map(t=>
 `<span class="tag">${esc(t)}</span>`
).join(" ");

const getProjects = async () => {
 const q = query(
  collection(db,"projects"),
  orderBy("created","desc"),
  limit(50)
 );
 const snap = await getDocs(q);
 return snap.docs.map(d=>({id:d.id,...d.data()}));
};

// ==========================================
// PROJECT DISPLAY
// ==========================================

const act = p => {
 if(!me)
  return '<a class="btn small" href="#/auth">SIGN IN TO APPLY</a>';

 if(p.owner === me.uid)
  return `<button class="btn small" data-a="del" data-id="${p.id}">DELETE</button>`;

 if(isClient()) return "";

 return `
 <details>
  <summary class="btn small">APPLY</summary>
  <form data-f="apply"
   data-id="${p.id}"
   data-title="${esc(p.title)}"
   data-owner="${p.owner}">
   <label class="field">Note to the client
    <textarea name="note" maxlength="400"
    placeholder="Why are you a good fit?"></textarea>
   </label>
   <button class="btn primary small" type="submit">SEND APPLICATION</button>
  </form>
 </details>`;
};

const card = (p,x="") => `
<article class="feature">
 <h3>${esc(p.title)}</h3>
 <p class="meta">
 ${p.beginner?'<span class="tag hot">Beginner-friendly</span>':""}
 ${x?`<span class="tag">${esc(x)}</span>`:""}
 </p>
 <p>${esc(p.desc)}</p>
 <p class="meta">${tags(p.skills)}</p>
 <p class="meta">By ${esc(p.ownerName)}
 ${p.budget?", budget "+esc(p.budget):""}</p>
 ${act(p)}
</article>`;

const postForm = () => `
<details class="panel">
 <summary class="btn primary small">POST A PROJECT</summary>
 <form data-f="post">
  <label class="field">Title
   <input name="title" required maxlength="80">
  </label>
  <label class="field">Description
   <textarea name="desc" required maxlength="600"></textarea>
  </label>
  <label class="field">Skills needed (comma separated)
   <input name="skills" required>
  </label>
  <label class="field">Budget (optional)
   <input name="budget" maxlength="30">
  </label>
  <label class="check">
   <input type="checkbox" name="beginner">
   Beginner-friendly
  </label>
  <button class="btn primary" type="submit">PUBLISH PROJECT</button>
 </form>
</details>`;

// ==========================================
// WEBSITE PAGES
// ==========================================

const V = {

home:()=>`
<section class="hero">
 <div class="logo">EditConnect</div>
 <h1>Skills Meet Opportunities.</h1>
 <p class="sub">
 Prove your skills. Earn recognition.
 Discover your first professional opportunity.
 </p>
 <div class="actions">
  <a class="btn primary" href="#/${me?"opps":"join"}">START NOW →</a>
  <a class="btn" href="#/opps">EXPLORE</a>
 </div>
</section>

<section class="wrap">
 <a class="feature lead" href="#/first">
  <span class="tag">Live</span>
  <h2>First Client Programme</h2>
  <p>Discover genuine opportunities for beginners.</p>
 </a>
 <div class="grid">
  <a class="feature" href="#/cert">
   <span class="tag">Waitlist open</span>
   <h3>Skill Certification</h3>
   <p>Practical skill assessments and certificates.</p>
  </a>
  <a class="feature" href="#/progress">
   <span class="tag">Live</span>
   <h3>Progress Tracking</h3>
   <p>Track your profile and applications.</p>
  </a>
  <a class="feature" href="#/match">
   <span class="tag">Live</span>
   <h3>Project Matching</h3>
   <p>Find projects matching your skills.</p>
  </a>
 </div>
</section>`,

opps:async()=>{
 const ps=await getProjects();
 return page(
  "Opportunities",
  "Projects posted by clients on EditConnect.",
  (isClient()?postForm():"")+
  (ps.length?ps.map(p=>card(p)).join(""):'<p class="muted">No projects yet.</p>')
 );
},

first:async()=>{
 const ps=(await getProjects()).filter(p=>p.beginner);
 let j;

 if(!me)
  j='<a class="btn primary" href="#/join">SIGN UP TO JOIN →</a>';
 else if(isClient())
  j='<p class="muted">Post a beginner-friendly project to list it here.</p>';
 else if(me.programme)
  j='<span class="tag hot">You are in the programme</span>';
 else
  j='<button class="btn primary" data-a="join">JOIN THE PROGRAMME</button>';

 return page(
  "First Client Programme",
  "Beginner-friendly projects from clients.",
  `<div class="panel">${j}</div>`+
  (ps.length?ps.map(p=>card(p)).join(""):'<p class="muted">No beginner-friendly projects yet.</p>')
 );
},

match:async()=>{
 if(!me) return gate("Sign in to see your matches");

 const ps=await getProjects();

 if(isClient()){
  const want=new Set(low(
   ps.filter(p=>p.owner===me.uid).flatMap(p=>p.skills)
  ));

  if(!want.size)
   return page("Matches","Post a project to find matching freelancers.","");

  const us=(await getDocs(query(
   collection(db,"users"),limit(200)
  ))).docs.map(d=>d.data()).filter(u=>u.role!=="Client");

  const r=us.map(u=>({
   u,
   n:low(u.skills).filter(s=>want.has(s)).length
  })).filter(x=>x.n).sort((a,b)=>b.n-a.n);

  return page(
   "Matches",
   "Freelancers whose skills overlap with your projects.",
   r.length?r.map(({u,n})=>`
   <article class="feature">
    <h3>${esc(u.name)}</h3>
    <p>${tags(u.skills)}</p>
    <p>${esc(u.bio)}</p>
    <p>${n} matching skills</p>
    ${safe(u.link)?`<a href="${esc(safe(u.link))}" target="_blank" rel="noopener">Portfolio</a>`:""}
   </article>`).join(""):'<p class="muted">No matches yet.</p>'
  );
 }

 const mine=low(me.skills);

 if(!mine.length)
  return page("Matches","Add skills to your profile.",'<a class="btn primary" href="#/profile">ADD SKILLS</a>');

 const r=ps.filter(p=>p.owner!==me.uid).map(p=>({
  p,n:low(p.skills).filter(s=>mine.includes(s)).length
 })).filter(x=>x.n).sort((a,b)=>b.n-a.n);

 return page(
  "Matches",
  "Projects ranked by matching skills.",
  r.length?r.map(({p,n})=>card(p,`${n} matching skills`)).join(""):'<p class="muted">No matching projects yet.</p>'
 );
},

cert:async()=>{
 if(!me)return gate("Sign in to join the waitlist");

 const rs=(await getDocs(query(
  collection(db,"requests"),
  where("uid","==",me.uid)
 ))).docs.map(d=>d.data());

 return page(
  "Certification",
  "Join the skill assessment waitlist.",
  `<form class="panel" data-f="cert">
   <label class="field">Skill
    <input name="skill" required maxlength="40" placeholder="Video editing">
   </label>
   <button class="btn primary" type="submit">JOIN WAITLIST</button>
  </form>
  <h3 class="sec">Your requests</h3>`+
  (rs.length?rs.map(r=>`
   <div class="row">
    <span>${esc(r.skill)}</span>
    <span class="tag">On waitlist</span>
   </div>`).join(""):'<p class="muted">No requests yet.</p>')
 );
},

progress:async()=>{
 if(!me)return gate("Sign in to track your progress");

 const cl=isClient();

 const ck=[
  ["Add your name",!!me.name],
  ["Choose your role",!!me.role],
  ["Write a short bio (20+ characters)",(me.bio||"").length>=20],
  ["Add at least 3 skills",(me.skills||[]).length>=3],
  ["Add a portfolio link",!!safe(me.link)]
 ];

 const pct=Math.round(
  ck.filter(c=>c[1]).length/ck.length*100
 );

 const apps=(await getDocs(query(
  collection(db,"applications"),
  where(cl?"owner":"applicant","==",me.uid)
 ))).docs.map(d=>d.data());

 const posted=cl?(await getProjects()).filter(p=>p.owner===me.uid).length:0;

 const st=cl?
 [[posted,"Projects posted"],[apps.length,"Applications received"]]:
 [[(me.skills||[]).length,"Skills listed"],[apps.length,"Applications sent"],[me.programme?"Yes":"No","First Client Programme"]];

 const todo=ck.filter(c=>!c[1]).map(c=>`<li>${c[0]}</li>`).join("");

 return page(
  "Progress",
  "Your activity on EditConnect.",
  `<div class="panel">
   <b>Profile ${pct}% complete</b>
   <div class="bar"><i style="width:${pct}%"></i></div>
   ${todo?`<ul>${todo}</ul><a class="btn small" href="#/profile">COMPLETE PROFILE</a>`:'<p>Profile complete.</p>'}
  </div>
  <div class="stats">
   ${st.map(s=>`<div><b>${s[0]}</b><span class="muted">${s[1]}</span></div>`).join("")}
  </div>
  <h3 class="sec">${cl?"Applications received":"Your applications"}</h3>`+
  (apps.length?apps.map(a=>cl?
   `<div class="row"><span><b>${esc(a.applicantName)}</b> applied to ${esc(a.projectTitle)}<br>${esc(a.note)}</span></div>`:
   `<div class="row"><span>${esc(a.projectTitle)}</span><span class="tag">Sent</span></div>`
  ).join(""):'<p class="muted">Nothing here yet.</p>')
 );
},

profile:()=>{
 if(!me)return gate("Sign in to edit your profile");

 return page(
  "Profile",
  "Manage your EditConnect profile.",
  `<form class="panel" data-f="profile">
   <label class="field">Full name
    <input name="name" required maxlength="60" value="${esc(me.name)}">
   </label>
   <label class="field">I am a
    <select name="role">
     ${roles.map(r=>`<option ${r===me.role?"selected":""}>${r}</option>`).join("")}
    </select>
   </label>
   <label class="field">Short bio
    <textarea name="bio" maxlength="300">${esc(me.bio)}</textarea>
   </label>
   <label class="field">Skills (comma separated)
    <input name="skills" value="${esc((me.skills||[]).join(", "))}">
   </label>
   <label class="field">Portfolio link
    <input name="link" type="url" value="${esc(me.link)}">
   </label>
   <button class="btn primary" type="submit">SAVE PROFILE</button>
  </form>`
 );
},

auth:()=>`
<div class="wrap pg narrow">
 <div class="panel">
  <h2>${mode==="in"?"Sign in":"Create your account"}</h2>

  <button class="btn google" type="button" data-a="google">
   <span class="google-icon">G</span>
   Continue with Google
  </button>

  <p class="muted" style="text-align:center;margin-bottom:18px">— OR —</p>

  <form data-f="auth">
   ${mode==="up"?`
    <label class="field">Full name
     <input name="name" required maxlength="60">
    </label>
    <fieldset class="roles">
     <legend>I am a</legend>
     ${roles.map((r,i)=>`
      <label>
       <input type="radio" name="role" value="${r}" ${i===0?"checked":""}>
       <span>${r}</span>
      </label>`).join("")}
    </fieldset>`:""}

   <label class="field">Email
    <input name="email" type="email" required autocomplete="email">
   </label>

   <label class="field">Password
    <input name="password" type="password" required minlength="6">
   </label>

   <button class="btn primary" type="submit">
    ${mode==="in"?"SIGN IN":"CREATE ACCOUNT"}
   </button>
  </form>

  <p class="sw">
   ${mode==="in"?
    `New here? <a href="#" data-a="mode">Create an account</a><br>
     <a href="#" data-a="reset">Forgot password?</a>`:
    `Already have an account? <a href="#" data-a="mode">Sign in</a>`
   }
  </p>
 </div>
</div>`
};

// ==========================================
// GOOGLE SIGN-IN AND ACCOUNT FUNCTIONS
// ==========================================

async function googleLogin(){

 const result=await signInWithPopup(auth,googleProvider);
 const user=result.user;
 const ref=doc(db,"users",user.uid);
 const snap=await getDoc(ref);

 if(!snap.exists()){
  await setDoc(ref,{
   name:user.displayName||"New User",
   role:"Student / Beginner Freelancer",
   bio:"",
   skills:[],
   link:"",
   programme:false,
   created:serverTimestamp()
  });
 }

 await load(user);
 location.hash="#/progress";
}

async function load(user){

 me=null;

 if(user){
  me={
   uid:user.uid,
   email:user.email||"",
   name:user.displayName||"",
   role:"Student / Beginner Freelancer",
   bio:"",
   skills:[],
   link:"",
   programme:false
  };

  const snap=await getDoc(doc(db,"users",user.uid));

  if(snap.exists()){
   Object.assign(me,snap.data());
  }else{
   await setDoc(doc(db,"users",user.uid),{
    name:me.name,
    role:me.role,
    bio:"",
    skills:[],
    link:"",
    programme:false,
    created:serverTimestamp()
   });
  }
 }

 paint();
}

// ==========================================
// BUTTON ACTIONS
// ==========================================

const A={

mode:()=>{
 mode=mode==="in"?"up":"in";
 view.innerHTML=V.auth();
},

google:async()=>{
 await googleLogin();
},

reset:async()=>{
 const email=view.querySelector('[name="email"]').value;

 if(!email){
  toast("Enter your email address first.");
  return;
 }

 await sendPasswordResetEmail(auth,email);
 toast("Password reset email sent.");
},

del:async b=>{
 if(!confirm("Delete this project?"))return;

 await deleteDoc(doc(db,"projects",b.dataset.id));
 toast("Project deleted.");
 go();
},

join:async()=>{
 await setDoc(doc(db,"users",me.uid),{
  programme:true
 },{merge:true});

 me.programme=true;
 toast("You joined the programme.");
 go();
}

};

// ==========================================
// FORM ACTIONS
// ==========================================

const F={

auth:async f=>{
 const d=Object.fromEntries(new FormData(f));

 if(mode==="in"){
  await signInWithEmailAndPassword(auth,d.email,d.password);
 }else{

  busy=true;

  try{
   const c=await createUserWithEmailAndPassword(
    auth,d.email,d.password
   );

   const p={
    name:d.name.trim(),
    role:d.role,
    bio:"",
    skills:[],
    link:"",
    programme:false,
    created:serverTimestamp()
   };

   await setDoc(doc(db,"users",c.user.uid),p);
   await load(c.user);

   location.hash="#/progress";

  }finally{
   busy=false;
  }
 }
},

post:async f=>{
 const d=Object.fromEntries(new FormData(f));

 await addDoc(collection(db,"projects"),{
  owner:me.uid,
  ownerName:me.name||"Client",
  title:d.title.trim(),
  desc:d.desc.trim(),
  skills:list(d.skills),
  budget:d.budget.trim(),
  beginner:!!d.beginner,
  created:serverTimestamp()
 });

 toast("Project published successfully.");
 go();
},

apply:async f=>{
 const d=f.dataset;

 await setDoc(doc(db,"applications",d.id+"_"+me.uid),{
  project:d.id,
  projectTitle:d.title,
  owner:d.owner,
  applicant:me.uid,
  applicantName:me.name||"",
  note:new FormData(f).get("note").trim(),
  created:serverTimestamp()
 });

 toast("Application sent successfully.");
 f.closest("details").open=false;
},

cert:async f=>{
 await addDoc(collection(db,"requests"),{
  uid:me.uid,
  skill:new FormData(f).get("skill").trim(),
  created:serverTimestamp()
 });

 toast("Added to the waitlist.");
 go();
},

profile:async f=>{
 const d=Object.fromEntries(new FormData(f));

 const p={
  name:d.name.trim(),
  role:d.role,
  bio:d.bio.trim(),
  skills:list(d.skills),
  link:safe(d.link.trim())
 };

 await setDoc(doc(db,"users",me.uid),p,{merge:true});
 Object.assign(me,p);

 toast("Profile saved successfully.");
}

};

// ==========================================
// EVENT HANDLERS
// ==========================================

view.addEventListener("click",async e=>{

 const b=e.target.closest("[data-a]");
 if(!b)return;

 if(b.tagName==="A")e.preventDefault();

 try{
  await A[b.dataset.a](b);
 }catch(x){
  toast(why(x));
 }

});

view.addEventListener("submit",async e=>{

 e.preventDefault();

 const f=e.target;
 const b=f.querySelector('[type="submit"]');

 if(b)b.disabled=true;

 try{
  await F[f.dataset.f](f);
 }catch(x){
  toast(why(x));
 }finally{
  if(b)b.disabled=false;
 }

});

// ==========================================
// WEBSITE ROUTER
// ==========================================

async function go(){

 let r=location.hash.replace("#/","")||"home";

 if(r==="out"){
  await signOut(auth);
  location.hash="#/home";
  return;
 }

 if(r==="join"){
  mode="up";
  r="auth";
 }else if(r==="auth"){
  mode="in";
 }

 document.querySelectorAll("#menu a").forEach(a=>{
  if(a.id!=="acct"){
   a.toggleAttribute(
    "aria-current",
    a.getAttribute("href")==="#/"+r
   );
  }
 });

 menu.classList.remove("open");
 burger.setAttribute("aria-expanded","false");

 view.innerHTML='<p class="muted wrap pg">Loading...</p>';

 try{
  view.innerHTML=await(V[r]||V.home)();
 }catch(e){
  view.innerHTML=page(
   "Something went wrong",
   esc(why(e)),
   '<a class="btn" href="#/home">GO HOME</a>'
  );
 }

 window.scrollTo(0,0);
}

// ==========================================
// START WEBSITE
// ==========================================

burger.addEventListener("click",()=>{
 const open=menu.classList.toggle("open");
 burger.setAttribute("aria-expanded",String(open));
});

window.addEventListener("hashchange",go);

onAuthStateChanged(auth,async user=>{

 if(busy)return;

 try{
  await load(user);

  if(me&&location.hash==="#/auth"){
   location.hash="#/progress";
  }else{
   await go();
  }

 }catch(e){
  toast(why(e));
  await go();
 }

});

paint();

</script>
</body>
</html>
