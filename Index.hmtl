<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#030508">
<title>EditConnect | Video Editors &amp; Clients</title>
<meta name="description" content="Find top video editors ranked by CONNECTS, completed projects, and verified portfolio branches.">

<style>
:root {
  --bg: #030508;
  --blue: #126BFF;
  --neon: #168BFF;
  --cyan: #38bdf8;
  --gold: #fbbf24;
  --green: #10b981;
  --muted: #8fa3bf;
  --line: rgba(22, 139, 255, .28);
  --glass: rgba(10, 20, 38, .72);
}
* { box-sizing: border-box; margin: 0; }
html { background: var(--bg); color-scheme: dark; scroll-behavior: smooth; }
body { color: #fff; font: 16px/1.6 system-ui, -apple-system, sans-serif; overflow-x: hidden; min-height: 100vh; display: flex; flex-direction: column; }
main { flex: 1; }
a { color: inherit; text-decoration: none; }
button, input, textarea, select { font: inherit; }
[hidden] { display: none !important; }

.wrap { max-width: 1080px; margin: auto; padding: 0 22px; }
.pg { padding-top: 104px; padding-bottom: 60px; }
.narrow { max-width: 540px; }
.muted { color: var(--muted); }
.ptitle { font-size: clamp(1.8rem, 4.5vw, 2.5rem); line-height: 1.15; margin-bottom: 6px; }
.sec { margin: 28px 0 12px; font-size: 1.25rem; }

/* Ambient Animated Background */
.lights { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
.lights i {
  position: absolute; width: 62vmax; height: 62vmax; border-radius: 50%;
  background: radial-gradient(circle, rgba(18, 107, 255, .17), transparent 65%);
  animation: drift 14s ease-in-out infinite alternate;
}
.lights i:first-child { top: -25vmax; left: -15vmax; }
.lights i:last-child { bottom: -30vmax; right: -20vmax; animation-delay: -7s; }

@keyframes drift {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(4vmax, 3vmax) scale(1.08); }
}

/* Navigation */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 30;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px clamp(18px, 4vw, 48px);
  background: rgba(3, 5, 8, .92);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(22, 139, 255, .16);
}
.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.2rem; letter-spacing: .03em; }
.brand-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--neon); box-shadow: 0 0 12px var(--neon); }
.menu { display: flex; align-items: center; gap: 20px; color: var(--muted); font-size: .92rem; }
.menu a:hover, .menu a[aria-current="true"] { color: #fff; }
.menu .signin { color: #fff; border: 1px solid var(--line); padding: 8px 18px; border-radius: 999px; transition: .2s; }
.menu .signin:hover { border-color: var(--neon); background: rgba(22, 139, 255, .12); }
.role-pill {
  font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
  padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line);
  background: rgba(22, 139, 255, .14); color: var(--cyan);
}
.burger { display: none; background: none; border: 1px solid var(--line); color: #fff; padding: 8px 12px; border-radius: 9px; cursor: pointer; }

/* Hero & Moving Center Icon */
.hero {
  min-height: 92svh; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center;
  padding: 112px 22px 60px;
}
.center-stage {
  position: relative; width: 148px; height: 148px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 22px;
}
.orbit-ring {
  position: absolute; inset: 0; border-radius: 50%;
  border: 1.5px dashed rgba(22, 139, 255, .45);
  animation: spinSlow 16s linear infinite;
}
.orbit-ring::after {
  content: ""; position: absolute; top: -5px; left: 50%; width: 10px; height: 10px;
  border-radius: 50%; background: var(--cyan); box-shadow: 0 0 14px var(--cyan);
}
.orbit-ring.inner {
  inset: 16px; border-style: solid; border-color: rgba(56, 189, 248, .25);
  animation: spinRev 10s linear infinite;
}
.moving-icon {
  width: 78px; height: 78px; border-radius: 22px;
  background: linear-gradient(135deg, #126BFF, #09265c);
  border: 1px solid rgba(56, 189, 248, .6);
  box-shadow: 0 0 35px rgba(18, 107, 255, .55);
  display: flex; align-items: center; justify-content: center;
  animation: floatIcon 3.2s ease-in-out infinite;
}
.moving-icon svg { width: 38px; height: 38px; fill: #fff; }

@keyframes spinSlow { to { transform: rotate(360deg); } }
@keyframes spinRev { to { transform: rotate(-360deg); } }
@keyframes floatIcon {
  0%, 100% { transform: translateY(0) scale(1); box-shadow: 0 0 30px rgba(18, 107, 255, .5); }
  50% { transform: translateY(-10px) scale(1.05); box-shadow: 0 14px 42px rgba(56, 189, 248, .75); }
}

/* Mode Switcher Directly Under Moving Icon */
.mode-switch {
  display: inline-flex; padding: 5px; border-radius: 999px;
  background: rgba(10, 20, 38, .9); border: 1px solid var(--line);
  margin-bottom: 20px; gap: 4px;
}
.mode-btn {
  padding: 9px 22px; border-radius: 999px; border: none; background: transparent;
  color: var(--muted); font-weight: 650; font-size: .9rem; cursor: pointer; transition: .2s;
}
.mode-btn.active { background: var(--blue); color: #fff; box-shadow: 0 0 18px rgba(22, 139, 255, .45); }

.explore-zone {
  min-height: 64px; display: flex; flex-direction: column; align-items: center; justify-content: center;
  margin-bottom: 24px;
}

h1 { font-size: clamp(2.1rem, 6vw, 4rem); line-height: 1.1; max-width: 16ch; }
.sub { max-width: 36em; margin: 16px 0 28px; color: var(--muted); font-size: 1.05rem; }
.actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 13px 26px; border: 1px solid var(--line);
  border-radius: 999px; background: rgba(10, 20, 38, .65); color: #fff;
  font-size: .9rem; font-weight: 650; letter-spacing: .03em;
  cursor: pointer; transition: .2s;
}
.btn:hover { transform: translateY(-2px); border-color: var(--neon); }
.btn.primary { background: var(--blue); border-color: transparent; box-shadow: 0 0 24px rgba(22, 139, 255, .4); }
.btn.primary:hover { background: var(--neon); }
.btn.explore-hero {
  padding: 15px 36px; font-size: 1rem;
  background: linear-gradient(90deg, #126BFF, #0ea5e9);
  border: none; box-shadow: 0 0 30px rgba(14, 165, 233, .45);
}
.btn.small { padding: 9px 18px; font-size: .82rem; }
.btn.danger { border-color: rgba(239, 68, 68, .45); color: #fca5a5; }
.btn.danger:hover { border-color: #ef4444; background: rgba(239, 68, 68, .12); }

/* Cards & Panels */
.panel {
  width: 100%; margin: 16px 0; padding: clamp(20px, 3.5vw, 32px);
  border: 1px solid var(--line); border-radius: 20px;
  background: var(--glass); backdrop-filter: blur(14px);
}
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 24px; }
.feature {
  display: block; padding: 24px; border: 1px solid var(--line);
  border-radius: 20px; background: var(--glass); transition: .22s;
}
.feature:hover { border-color: var(--neon); box-shadow: 0 0 24px rgba(22, 139, 255, .14); }

/* Editor Leaderboard Card */
.editor-card {
  margin-top: 18px; padding: 24px; border: 1px solid var(--line);
  border-radius: 20px; background: var(--glass); transition: .22s;
}
.editor-card:hover { border-color: var(--neon); }
.ed-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 14px; }
.ed-rank {
  display: inline-flex; align-items: center; justify-content: center;
  width: 32px; height: 32px; border-radius: 50%;
  background: rgba(22, 139, 255, .2); border: 1px solid var(--neon);
  font-weight: 800; font-size: .85rem; color: var(--cyan); margin-right: 10px;
}
.connects-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 16px; border-radius: 999px;
  background: linear-gradient(135deg, rgba(18, 107, 255, .28), rgba(56, 189, 248, .18));
  border: 1px solid var(--cyan); color: #fff; font-weight: 800; font-size: .95rem;
}
.connects-pill span { color: var(--cyan); }
.ed-metrics {
  display: flex; flex-wrap: wrap; gap: 14px; margin: 14px 0;
  font-size: .88rem; color: var(--muted);
}
.ed-metrics b { color: #fff; }
.stars-display { color: var(--gold); font-weight: 700; letter-spacing: 1px; }

.tag {
  display: inline-block; margin: 0 6px 6px 0; padding: 4px 12px;
  border: 1px solid var(--line); border-radius: 999px;
  color: var(--cyan); background: rgba(22, 139, 255, .08); font-size: .78rem; font-weight: 600;
}
.tag.branch { border-color: rgba(56, 189, 248, .45); color: #e0f2fe; }
.tag.hot { background: var(--blue); color: #fff; border-color: transparent; }

/* Portfolio Grid inside Editor Card / Studio */
.port-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; margin-top: 12px; }
.port-item {
  padding: 14px; border-radius: 14px; border: 1px solid rgba(22, 139, 255, .22);
  background: rgba(3, 5, 8, .65);
}
.port-item h4 { font-size: .96rem; margin: 6px 0 4px; }
.port-item p { font-size: .83rem; color: var(--muted); margin-bottom: 8px; }

/* Forms & Inputs */
.field { display: block; margin-bottom: 15px; color: var(--muted); font-size: .86rem; }
.field input, .field textarea, .field select {
  display: block; width: 100%; margin-top: 6px; padding: 12px 14px;
  border: 1px solid var(--line); border-radius: 12px;
  background: rgba(3, 5, 8, .85); color: #fff;
}
.field textarea { min-height: 82px; resize: vertical; }
.field input:focus, .field textarea:focus, .field select:focus { outline: 1px solid var(--neon); }

.filter-bar { display: flex; flex-wrap: wrap; gap: 12px; margin: 18px 0; }
.filter-bar input, .filter-bar select {
  padding: 11px 15px; border-radius: 12px; border: 1px solid var(--line);
  background: rgba(10, 20, 38, .85); color: #fff;
}
.filter-bar input { flex: 1; min-width: 210px; }

/* Star Picker */
.star-picker { display: flex; gap: 6px; margin: 8px 0; }
.star-btn {
  padding: 7px 13px; border-radius: 10px; border: 1px solid var(--line);
  background: rgba(3, 5, 8, .8); color: var(--muted); cursor: pointer; font-weight: 700;
}
.star-btn.active { border-color: var(--gold); color: var(--gold); background: rgba(251, 191, 36, .12); }

/* Branch Checkboxes */
.branch-picks { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.branch-chip {
  padding: 6px 13px; border-radius: 999px; border: 1px solid var(--line);
  background: rgba(3, 5, 8, .75); color: var(--muted); font-size: .8rem; cursor: pointer;
}
.branch-chip.selected { border-color: var(--cyan); color: #fff; background: rgba(22, 139, 255, .25); }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin: 18px 0; }
.stats div { padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--glass); }
.stats b { display: block; font-size: 1.7rem; color: #fff; }
.bar { height: 8px; margin: 12px 0; border-radius: 99px; background: rgba(22, 139, 255, .15); overflow: hidden; }
.bar i { display: block; height: 100%; background: var(--neon); }

.row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(22, 139, 255, .14); }
.foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 24px 28px; border-top: 1px solid var(--line); color: var(--muted); font-size: .82rem; }
#toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 60; max-width: 92vw; padding: 13px 22px; border: 1px solid var(--cyan); border-radius: 12px; background: #071224; box-shadow: 0 10px 30px rgba(0,0,0,.6); }

@media (max-width: 860px) {
  .grid { grid-template-columns: 1fr; }
  .burger { display: block; }
  .menu {
    display: none; position: absolute; top: 100%; left: 0; right: 0;
    flex-direction: column; align-items: stretch; gap: 0;
    padding: 12px 20px; background: #030508; border-bottom: 1px solid var(--line);
  }
  .menu.open { display: flex; }
  .menu a { padding: 12px; border-bottom: 1px solid rgba(22, 139, 255, .1); }
  .menu .signin { text-align: center; margin-top: 10px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
</style>
</head>

<body>
<div class="lights"><i></i><i></i></div>

<header class="nav">
  <a class="brand" href="#/home"><span class="brand-dot"></span>EditConnect</a>
  <button class="burger" id="burger" aria-expanded="false" aria-label="Toggle menu">☰</button>
  <nav class="menu" id="menu"></nav>
</header>

<main id="view"></main>

<footer class="foot">
  <span>© 2026 EditConnect</span>
  <span>Transparent Video Editing Marketplace • Powered by CONNECTS</span>
</footer>

<div id="toast" role="status" hidden></div>

<script>
// ==========================================
// STORAGE & DEMO SEED DATA
// ==========================================
const STORAGE_KEY = "editconnect_github_v1";

const DEFAULT_BRANCHES = [
  "YouTube Long-Form",
  "Reels & Shorts",
  "Motion Graphics",
  "Color Grading",
  "Gaming & Montage",
  "Documentary",
  "Podcasts & Talking Head",
  "VFX & Transitions"
];

const SEED_USERS = [
  {
    id: "ed_aarav",
    name: "Aarav Mehta",
    email: "aarav@editconnect.demo",
    password: "password123",
    role: "editor",
    experience: "4 Years",
    pricing: "$60 / video",
    availability: "Available Now",
    bio: "Documentary & retention-focused YouTube editor. Specialized in pacing, sound design, and DaVinci Resolve color grading.",
    branches: ["YouTube Long-Form", "Documentary", "Color Grading"],
    connects: 86,
    projectsCompleted: 6,
    portfolio: [
      {
        id: "p1",
        title: "How Tech Giants Build AI Chips (22-Min Doc)",
        branch: "Documentary",
        url: "https://youtube.com",
        notes: "Premiere Pro + After Effects • 480K+ views"
      },
      {
        id: "p2",
        title: "Cinematic Travel LUT & Grade Breakdown",
        branch: "Color Grading",
        url: "https://youtube.com",
        notes: "DaVinci Resolve Studio • LOG to Rec.709"
      }
    ],
    reviews: [
      { clientName: "Vikram Sethi", projectTitle: "Main Channel Documentary", stars: 5, projectConnects: 10, starConnects: 10, comment: "Incredible storytelling and sound design." },
      { clientName: "Sarah Jenkins", projectTitle: "Brand Story Cut", stars: 4, projectConnects: 10, starConnects: 8, comment: "Delivered ahead of schedule with clean color." }
    ]
  },
  {
    id: "ed_elena",
    name: "Elena Vance",
    email: "elena@editconnect.demo",
    password: "password123",
    role: "editor",
    experience: "3 Years",
    pricing: "$35 / short",
    availability: "Available Now",
    bio: "High-retention short-form editor for creators and founders. Custom kinetic captions, sound FX, and smooth motion graphics.",
    branches: ["Reels & Shorts", "Motion Graphics"],
    connects: 78,
    projectsCompleted: 5,
    portfolio: [
      {
        id: "p3",
        title: "30-Day Founder Reels Pack (High Retention)",
        branch: "Reels & Shorts",
        url: "https://youtube.com",
        notes: "After Effects • 1.2M organic reach"
      },
      {
        id: "p4",
        title: "SaaS Product Launch Motion Explainer",
        branch: "Motion Graphics",
        url: "https://youtube.com",
        notes: "After Effects + Illustrator • 60fps"
      }
    ],
    reviews: [
      { clientName: "Vikram Sethi", projectTitle: "10 Viral Shorts Bundle", stars: 5, projectConnects: 10, starConnects: 10, comment: "Doubled our average watch duration." }
    ]
  },
  {
    id: "ed_rohan",
    name: "Rohan Kapoor",
    email: "rohan@editconnect.demo",
    password: "password123",
    role: "editor",
    experience: "2.5 Years",
    pricing: "$45 / video",
    availability: "Available Now",
    bio: "Fast-paced gaming, montage, and VFX editor. Beat-synced cuts, 3D camera shakes, and custom transitions.",
    branches: ["Gaming & Montage", "VFX & Transitions", "Reels & Shorts"],
    connects: 54,
    projectsCompleted: 4,
    portfolio: [
      {
        id: "p5",
        title: "Valorant Championship Frag Montage",
        branch: "Gaming & Montage",
        url: "https://youtube.com",
        notes: "After Effects + Blender 3D Camera"
      }
    ],
    reviews: [
      { clientName: "Sarah Jenkins", projectTitle: "Esports Highlight Reel", stars: 4, projectConnects: 8, starConnects: 8, comment: "Super clean transitions and sync." }
    ]
  },
  {
    id: "ed_maya",
    name: "Maya Lin",
    email: "maya@editconnect.demo",
    password: "password123",
    role: "editor",
    experience: "1.5 Years",
    pricing: "$25 / episode",
    availability: "Available Now",
    bio: "Clean multi-cam podcast editing, audio leveling, and engaging YouTube talking-head cuts with B-roll.",
    branches: ["Podcasts & Talking Head", "YouTube Long-Form"],
    connects: 36,
    projectsCompleted: 2,
    portfolio: [
      {
        id: "p6",
        title: "Startup Weekly Podcast Ep. #42 + Clips",
        branch: "Podcasts & Talking Head",
        url: "https://youtube.com",
        notes: "Premiere Pro + Audition Studio Audio"
      }
    ],
    reviews: [
      { clientName: "Vikram Sethi", projectTitle: "Founder Interview Edit", stars: 4, projectConnects: 10, starConnects: 8, comment: "Crisp audio and great pacing." }
    ]
  },
  {
    id: "cl_vikram",
    name: "Vikram Sethi",
    email: "client@editconnect.demo",
    password: "password123",
    role: "client",
    bio: "Tech creator & channel producer hiring editors for weekly YouTube documentaries and daily shorts.",
    history: [
      { editorName: "Aarav Mehta", projectTitle: "Main Channel Documentary", stars: 5, connectsAwarded: 20 },
      { editorName: "Elena Vance", projectTitle: "10 Viral Shorts Bundle", stars: 5, connectsAwarded: 20 }
    ]
  },
  {
    id: "cl_sarah",
    name: "Sarah Jenkins",
    email: "sarah@editconnect.demo",
    password: "password123",
    role: "client",
    bio: "Digital media producer looking for reliable motion graphics and podcast editors.",
    history: [
      { editorName: "Rohan Kapoor", projectTitle: "Esports Highlight Reel", stars: 4, connectsAwarded: 16 }
    ]
  }
];

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  const initial = {
    users: JSON.parse(JSON.stringify(SEED_USERS)),
    currentUserId: null,
    browseMode: "client"
  };
  saveState(initial);
  return initial;
}

function saveState(nextState) {
  state = nextState;
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  } catch (e) {}
}

let state = loadState();
let authMode = "in";
let authRole = "client";
let searchTerm = "";
let branchFilter = "ALL";
let sortBy = "connects";

// ==========================================
// HELPERS
// ==========================================
const $ = s => document.querySelector(s);
const view = $("#view");
const menu = $("#menu");
const burger = $("#burger");

const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({
  "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
}[c]));

const safeUrl = u => /^https?:\/\//i.test((u || "").trim()) ? u.trim() : "";

const currentUser = () => state.users.find(u => u.id === state.currentUserId) || null;
const activeMode = () => {
  const u = currentUser();
  return u ? u.role : state.browseMode;
};

const getEditors = () => state.users.filter(u => u.role === "editor");

const getAllBranchesForEditor = ed => {
  const set = new Set(ed.branches || []);
  (ed.portfolio || []).forEach(p => { if (p.branch) set.add(p.branch); });
  return [...set];
};

const avgStars = ed => {
  const revs = ed.reviews || [];
  if (!revs.length) return "New";
  const sum = revs.reduce((acc, r) => acc + Number(r.stars || 0), 0);
  return (sum / revs.length).toFixed(1) + " ★";
};

function toast(msg) {
  const el = $("#toast");
  el.textContent = msg;
  el.hidden = false;
  clearTimeout(toast._t);
  toast._t = setTimeout(() => { el.hidden = true; }, 4000);
}

// ==========================================
// NAVIGATION RENDERER
// ==========================================
function renderNav() {
  const u = currentUser();
  const mode = activeMode();

  let links = `<a href="#/home">Home</a>`;

  if (mode === "client") {
    links += `<a href="#/explore">Explore Editors</a>`;
    if (u) links += `<a href="#/activity">Client Activity</a>`;
  } else {
    // Editor Mode: Explore is strictly hidden
    if (u) links += `<a href="#/studio">Portfolio Studio</a>`;
  }

  if (u) {
    links += `<span class="role-pill">${u.role === "client" ? "Client Mode" : "Editor Mode"}</span>`;
    links += `<a href="#/logout" class="signin">Sign out (${esc(u.name.split(" ")[0])})</a>`;
  } else {
    links += `<a href="#/auth" class="signin">Sign in / Register</a>`;
  }

  menu.innerHTML = links;

  const currentHash = location.hash || "#/home";
  menu.querySelectorAll("a").forEach(a => {
    if (a.getAttribute("href") === currentHash) {
      a.setAttribute("aria-current", "true");
    }
  });
}

// ==========================================
// VIEWS
// ==========================================
const Views = {
  home() {
    const u = currentUser();
    const mode = activeMode();
    const editors = getEditors().sort((a, b) => b.connects - a.connects);

    return `
    <section class="hero">
      <div class="center-stage" aria-hidden="true">
        <div class="orbit-ring"></div>
        <div class="orbit-ring inner"></div>
        <div class="moving-icon">
          <svg viewBox="0 0 24 24"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5zm6 4.2v5.6a.8.8 0 0 0 1.24.67l4.4-2.8a.8.8 0 0 0 0-1.34l-4.4-2.8A.8.8 0 0 0 10 9.2z"/></svg>
        </div>
      </div>

      ${!u ? `
      <div class="mode-switch" role="group" aria-label="Select Role Mode">
        <button type="button" class="mode-btn ${mode === "client" ? "active" : ""}" data-act="setMode" data-mode="client">I am a Client</button>
        <button type="button" class="mode-btn ${mode === "editor" ? "active" : ""}" data-act="setMode" data-mode="editor">I am an Editor</button>
      </div>
      ` : `
      <div style="margin-bottom:14px">
        <span class="role-pill">Signed in as ${esc(u.name)} (${u.role})</span>
      </div>
      `}

      <div class="explore-zone">
        ${mode === "client" ? `
          <a class="btn explore-hero" href="#/explore">EXPLORE EDITORS →</a>
          <span class="muted" style="font-size:.82rem;margin-top:8px">Compare ${editors.length} editors by CONNECTS, completed projects &amp; pricing</span>
        ` : `
          <a class="btn primary" href="${u ? "#/studio" : "#/auth"}">${u ? "OPEN PORTFOLIO STUDIO →" : "REGISTER AS EDITOR →"}</a>
          <span class="muted" style="font-size:.82rem;margin-top:8px">Editor Mode: Build your portfolio &amp; branch tags to get discovered by clients</span>
        `}
      </div>

      <h1>${mode === "client" ? "Hire Proven Video Editors." : "Let Your Portfolio Speak."}</h1>
      <p class="sub">
        ${mode === "client"
          ? "No guesswork. Compare editors transparently by earned CONNECTS, completed projects, verified star ratings, and branch specialties."
          : "Upload your best edits tagged by branch. Clients discover you based on your CONNECTS, completed projects, and portfolio work."}
      </p>

      <div class="actions">
        ${!u ? `
          <a class="btn" href="#/join">CREATE FREE PROFILE</a>
          <button type="button" class="btn small" data-act="demoLogin" data-role="${mode}">INSTANT DEMO (${mode.toUpperCase()})</button>
        ` : mode === "client" ? `
          <a class="btn" href="#/activity">VIEW MY RATINGS &amp; PROJECTS</a>
        ` : `
          <a class="btn" href="#/studio">MANAGE PORTFOLIO &amp; BRANCHES</a>
        `}
      </div>
    </section>

    <section class="wrap" style="padding-bottom:60px">
      <div class="grid">
        <div class="feature">
          <span class="tag hot">CONNECTS Engine</span>
          <h3 style="margin:10px 0 6px">Earned Reputation</h3>
          <p class="muted">Every completed project awards up to <b>10 CONNECTS</b>, and every client star (0–5 ★) converts into <b>2 CONNECTS</b>.</p>
        </div>
        <div class="feature">
          <span class="tag">Client-First Discovery</span>
          <h3 style="margin:10px 0 6px">Zero Cold Spam</h3>
          <p class="muted">Editors cannot pester clients. Clients explore ranked editors with clear pricing, experience, and project counts.</p>
        </div>
        <div class="feature">
          <span class="tag">Branch Portfolios</span>
          <h3 style="margin:10px 0 6px">Skill-Tagged Work</h3>
          <p class="muted">Editors upload portfolio pieces under editing branches so clients immediately see proven work in their niche.</p>
        </div>
      </div>
    </section>`;
  },

  explore() {
    const u = currentUser();
    const mode = activeMode();

    // Editors cannot access Explore
    if (mode === "editor") {
      return `
      <div class="wrap pg narrow">
        <div class="panel">
          <span class="tag hot">Editor Mode Active</span>
          <h2 style="margin:12px 0 8px">Explore is for Clients Only</h2>
          <p class="muted" style="margin-bottom:20px">
            On EditConnect, editors cannot browse or approach clients directly. Instead, build your portfolio and branch tags so clients can discover and hire you.
          </p>
          <a class="btn primary" href="${u ? "#/studio" : "#/home"}">${u ? "GO TO PORTFOLIO STUDIO →" : "BACK TO HOME"}</a>
        </div>
      </div>`;
    }

    const allBranches = [...new Set([
      ...DEFAULT_BRANCHES,
      ...getEditors().flatMap(getAllBranchesForEditor)
    ])];

    let list = getEditors().map(ed => ({
      ...ed,
      allBranches: getAllBranchesForEditor(ed)
    }));

    if (branchFilter !== "ALL") {
      list = list.filter(ed => ed.allBranches.includes(branchFilter));
    }

    if (searchTerm.trim()) {
      const q = searchTerm.trim().toLowerCase();
      list = list.filter(ed =>
        ed.name.toLowerCase().includes(q) ||
        (ed.bio || "").toLowerCase().includes(q) ||
        ed.allBranches.some(b => b.toLowerCase().includes(q))
      );
    }

    list.sort((a, b) => {
      if (sortBy === "projects") return (b.projectsCompleted || 0) - (a.projectsCompleted || 0);
      if (sortBy === "connects") return (b.connects || 0) - (a.connects || 0);
      return (b.connects || 0) - (a.connects || 0);
    });

    return `
    <div class="wrap pg">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:14px">
        <div>
          <h2 class="ptitle">Explore Video Editors</h2>
          <p class="muted">Ranked by earned CONNECTS and completed project progress.</p>
        </div>
        ${!u ? `
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button type="button" class="btn small primary" data-act="demoLogin" data-role="client">Demo Client Login (To Rate)</button>
            <a class="btn small" href="#/auth">Sign In</a>
          </div>
        ` : `<span class="tag">Logged in as Client: ${esc(u.name)}</span>`}
      </div>

      <div class="filter-bar">
        <input type="search" id="searchInput" placeholder="Search editor name, style, or branch..." value="${esc(searchTerm)}">
        <select id="branchSelect">
          <option value="ALL">All Editing Branches</option>
          ${allBranches.map(b => `<option value="${esc(b)}" ${branchFilter === b ? "selected" : ""}>${esc(b)}</option>`).join("")}
        </select>
        <select id="sortSelect">
          <option value="connects" ${sortBy === "connects" ? "selected" : ""}>Sort: Highest CONNECTS</option>
          <option value="projects" ${sortBy === "projects" ? "selected" : ""}>Sort: Most Projects</option>
        </select>
      </div>

      ${list.length ? list.map((ed, idx) => `
        <article class="editor-card">
          <div class="ed-top">
            <div>
              <div style="display:flex;align-items:center;flex-wrap:wrap;gap:8px">
                <span class="ed-rank">#${idx + 1}</span>
                <h3 style="font-size:1.35rem">${esc(ed.name)}</h3>
                <span class="tag">${esc(ed.availability || "Available Now")}</span>
              </div>
              <p class="muted" style="margin-top:8px;max-width:62ch">${esc(ed.bio || "Video editor ready for new projects.")}</p>
            </div>
            <div class="connects-pill" title="Earned from completed projects and client star ratings">
              ⚡ <span>${ed.connects || 0}</span> CONNECTS
            </div>
          </div>

          <div class="ed-metrics">
            <span>Pricing: <b>${esc(ed.pricing || "Contact for rate")}</b></span>
            <span>•</span>
            <span>Experience: <b>${esc(ed.experience || "1+ Year")}</b></span>
            <span>•</span>
            <span>Completed Projects: <b>${ed.projectsCompleted || 0}</b></span>
            <span>•</span>
            <span>Rating: <span class="stars-display">${avgStars(ed)}</span> (${(ed.reviews || []).length})</span>
          </div>

          <div style="margin:10px 0 14px">
            ${ed.allBranches.length
              ? ed.allBranches.map(b => `<span class="tag branch"># ${esc(b)}</span>`).join("")
              : `<span class="muted" style="font-size:.82rem">No branch tags added yet</span>`}
          </div>

          <details>
            <summary class="btn small">VIEW PORTFOLIO (${(ed.portfolio || []).length}) &amp; AWARD CONNECTS</summary>
            <div style="margin-top:16px;padding-top:16px;border-top:1px solid rgba(22,139,255,.16)">
              <h4 style="margin-bottom:8px;color:var(--cyan)">Portfolio Showcase</h4>
              ${(ed.portfolio || []).length ? `
                <div class="port-grid">
                  ${ed.portfolio.map(item => `
                    <div class="port-item">
                      <span class="tag branch">${esc(item.branch)}</span>
                      <h4>${esc(item.title)}</h4>
                      <p>${esc(item.notes || "")}</p>
                      ${safeUrl(item.url) ? `<a class="btn small" href="${esc(safeUrl(item.url))}" target="_blank" rel="noopener">Watch Sample ↗</a>` : ""}
                    </div>
                  `).join("")}
                </div>
              ` : `<p class="muted" style="font-size:.9rem">No portfolio samples uploaded yet.</p>`}

              <div style="margin-top:22px;padding:18px;border-radius:16px;background:rgba(3,5,8,.7);border:1px solid var(--line)">
                <h4 style="margin-bottom:4px">Complete Project &amp; Rate ${esc(ed.name)}</h4>
                <p class="muted" style="font-size:.84rem;margin-bottom:14px">
                  Completing a project awards up to <b>10 CONNECTS</b>. Each star (0–5 ★) adds <b>2 CONNECTS</b>.
                </p>

                ${u && u.role === "client" ? `
                  <form data-form="rateEditor" data-editor-id="${esc(ed.id)}">
                    <label class="field">Project Name
                      <input name="projectTitle" required maxlength="70" placeholder="e.g., YouTube Channel Trailer Edit">
                    </label>

                    <label class="field">Direct Project Completion Reward (1 to 10 CONNECTS)
                      <select name="projectConnects">
                        <option value="10" selected>+10 CONNECTS (Full Project Completed)</option>
                        <option value="8">+8 CONNECTS</option>
                        <option value="6">+6 CONNECTS</option>
                        <option value="5">+5 CONNECTS</option>
                        <option value="3">+3 CONNECTS</option>
                        <option value="1">+1 CONNECT</option>
                        <option value="0">0 CONNECTS (Star Rating Only)</option>
                      </select>
                    </label>

                    <div class="field">
                      <span>Star Rating (0 to 5 Stars — 1 Star = 2 CONNECTS)</span>
                      <input type="hidden" name="stars" value="5">
                      <div class="star-picker" data-star-group>
                        ${[0, 1, 2, 3, 4, 5].map(n => `
                          <button type="button" class="star-btn ${n === 5 ? "active" : ""}" data-act="pickStar" data-val="${n}">
                            ${n} ★ (+${n * 2})
                          </button>
                        `).join("")}
                      </div>
                    </div>

                    <label class="field">Feedback Note (Optional)
                      <input name="comment" maxlength="160" placeholder="Great communication and crisp cuts!">
                    </label>

                    <button type="submit" class="btn primary small">CONFIRM PROJECT &amp; AWARD CONNECTS</button>
                  </form>
                ` : `
                  <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
                    <a class="btn primary small" href="#/auth">Sign in as Client to Rate</a>
                    <button type="button" class="btn small" data-act="demoLogin" data-role="client">1-Click Demo Client Sign-In</button>
                  </div>
                `}
              </div>

              ${(ed.reviews || []).length ? `
                <h4 style="margin:18px 0 8px">Recent Client Reviews</h4>
                ${ed.reviews.map(r => `
                  <div class="row" style="font-size:.88rem">
                    <div>
                      <b>${esc(r.clientName)}</b> • <span class="muted">${esc(r.projectTitle)}</span>
                      ${r.comment ? `<div class="muted">"${esc(r.comment)}"</div>` : ""}
                    </div>
                    <div style="text-align:right;white-space:nowrap">
                      <span class="stars-display">${r.stars} ★</span>
                      <div style="color:var(--cyan);font-weight:700;font-size:.8rem">+${(r.projectConnects || 0) + (r.starConnects || 0)} CONNECTS</div>
                    </div>
                  </div>
                `).join("")}
              ` : ""}
            </div>
          </details>
        </article>
      `).join("") : `<div class="panel"><p class="muted">No editors match that filter yet.</p></div>`}
    </div>`;
  },

  studio() {
    const u = currentUser();
    if (!u) return Views.auth();
    if (u.role !== "editor") {
      return `
      <div class="wrap pg narrow">
        <div class="panel">
          <h2>Client Account Active</h2>
          <p class="muted" style="margin:10px 0 18px">Portfolio Studio is for Video Editors. Head to Explore to find editors.</p>
          <a class="btn primary" href="#/explore">EXPLORE EDITORS →</a>
        </div>
      </div>`;
    }

    const branches = getAllBranchesForEditor(u);
    const portfolio = u.portfolio || [];
    const checks = [
      !!u.name,
      (u.bio || "").length >= 15,
      !!u.pricing,
      branches.length >= 1,
      portfolio.length >= 1
    ];
    const pct = Math.round((checks.filter(Boolean).length / checks.length) * 100);

    return `
    <div class="wrap pg">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px">
        <div>
          <h2 class="ptitle">Editor Portfolio Studio</h2>
          <p class="muted">Build your portfolio and branch tags. Clients discover you by your CONNECTS &amp; progress.</p>
        </div>
        <div class="connects-pill">⚡ <span>${u.connects || 0}</span> CONNECTS</div>
      </div>

      <div class="stats">
        <div><b>${u.connects || 0}</b><span class="muted">Total CONNECTS</span></div>
        <div><b>${u.projectsCompleted || 0}</b><span class="muted">Completed Projects</span></div>
        <div><b>${avgStars(u)}</b><span class="muted">Client Rating</span></div>
        <div><b>${portfolio.length}</b><span class="muted">Portfolio Works</span></div>
      </div>

      <div class="panel">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <b>Profile Strength: ${pct}%</b>
          <span class="muted" style="font-size:.84rem">Explore button is disabled in Editor Mode</span>
        </div>
        <div class="bar"><i style="width:${pct}%"></i></div>
      </div>

      <div class="panel">
        <h3 style="margin-bottom:14px">1. Upload Portfolio Work (Auto-Tags Your Branch)</h3>
        <form data-form="addPortfolio">
          <label class="field">Project Title
            <input name="title" required maxlength="80" placeholder="e.g., High-Retention Finance YouTube Video">
          </label>
          <label class="field">Editing Branch (Displayed as a tag on your profile for clients)
            <input name="branch" list="branchSuggestions" required maxlength="40" placeholder="Select or type a branch (e.g., Reels & Shorts)">
            <datalist id="branchSuggestions">
              ${DEFAULT_BRANCHES.map(b => `<option value="${esc(b)}">`).join("")}
            </datalist>
          </label>
          <label class="field">Video / Portfolio Link (Optional — YouTube, Google Drive, Vimeo)
            <input name="url" type="url" placeholder="https://youtube.com/...">
          </label>
          <label class="field">Software &amp; Project Highlights
            <input name="notes" maxlength="120" placeholder="e.g., Premiere Pro + After Effects • Sound Design &amp; Color">
          </label>
          <button type="submit" class="btn primary">ADD TO PORTFOLIO &amp; TAG BRANCH</button>
        </form>

        ${portfolio.length ? `
          <h4 style="margin:22px 0 10px;color:var(--cyan)">Your Uploaded Portfolio (${portfolio.length})</h4>
          <div class="port-grid">
            ${portfolio.map(item => `
              <div class="port-item">
                <span class="tag branch"># ${esc(item.branch)}</span>
                <h4>${esc(item.title)}</h4>
                <p>${esc(item.notes || "")}</p>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
                  ${safeUrl(item.url) ? `<a class="btn small" href="${esc(safeUrl(item.url))}" target="_blank" rel="noopener">Open Link ↗</a>` : ""}
                  <button type="button" class="btn small danger" data-act="delPortfolio" data-id="${esc(item.id)}">Remove</button>
                </div>
              </div>
            `).join("")}
          </div>
        ` : ""}
      </div>

      <div class="panel">
        <h3 style="margin-bottom:14px">2. Rates, Experience &amp; Branch Tags</h3>
        <form data-form="saveEditorProfile">
          <label class="field">Display Name
            <input name="name" required maxlength="60" value="${esc(u.name)}">
          </label>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px">
            <label class="field">Pricing Rate
              <input name="pricing" required maxlength="40" value="${esc(u.pricing || "")}" placeholder="e.g., $40 / video">
            </label>
            <label class="field">Editing Experience
              <input name="experience" required maxlength="40" value="${esc(u.experience || "")}" placeholder="e.g., 3 Years">
            </label>
            <label class="field">Availability Status
              <select name="availability">
                <option ${u.availability === "Available Now" ? "selected" : ""}>Available Now</option>
                <option ${u.availability === "Open for Long-Term" ? "selected" : ""}>Open for Long-Term</option>
                <option ${u.availability === "Limited Slots" ? "selected" : ""}>Limited Slots</option>
              </select>
            </label>
          </div>
          <label class="field">Bio &amp; Editing Style
            <textarea name="bio" maxlength="300" placeholder="Describe your editing strengths...">${esc(u.bio || "")}</textarea>
          </label>
          <div class="field">
            <span>Active Branch Tags (Click to toggle)</span>
            <div class="branch-picks">
              ${DEFAULT_BRANCHES.map(b => `
                <button type="button" class="branch-chip ${branches.includes(b) ? "selected" : ""}" data-act="toggleBranch" data-branch="${esc(b)}">
                  ${branches.includes(b) ? "✓ " : "+ "}${esc(b)}
                </button>
              `).join("")}
            </div>
          </div>
          <button type="submit" class="btn primary">SAVE EDITOR PROFILE</button>
        </form>
      </div>
    </div>`;
  },

  activity() {
    const u = currentUser();
    if (!u) return Views.auth();
    const hist = u.history || [];

    return `
    <div class="wrap pg">
      <h2 class="ptitle">Client Activity</h2>
      <p class="muted">Projects you completed and CONNECTS awarded to editors.</p>

      <div class="stats">
        <div><b>${hist.length}</b><span class="muted">Projects Completed</span></div>
        <div><b>${hist.reduce((a, b) => a + (b.connectsAwarded || 0), 0)}</b><span class="muted">Total CONNECTS Awarded</span></div>
      </div>

      <div class="panel">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
          <h3>Completed Project History</h3>
          <a class="btn primary small" href="#/explore">EXPLORE MORE EDITORS →</a>
        </div>
        ${hist.length ? hist.map(h => `
          <div class="row">
            <div>
              <b>${esc(h.editorName)}</b> — <span class="muted">${esc(h.projectTitle)}</span>
            </div>
            <div style="text-align:right">
              <span class="stars-display">${h.stars} ★</span>
              <span class="tag" style="margin-left:8px">+${h.connectsAwarded} CONNECTS</span>
            </div>
          </div>
        `).join("") : `<p class="muted">No completed projects logged yet. Visit Explore Editors to rate an editor.</p>`}
      </div>
    </div>`;
  },

  auth() {
    return `
    <div class="wrap pg narrow">
      <div class="panel">
        <h2 style="margin-bottom:6px">${authMode === "in" ? "Sign in to EditConnect" : "Create your profile"}</h2>
        <p class="muted" style="margin-bottom:18px;font-size:.9rem">
          ${authMode === "in" ? "Access your Client or Editor account." : "Register as a Client to explore editors, or as an Editor to showcase your portfolio."}
        </p>

        <form data-form="auth">
          ${authMode === "up" ? `
            <div class="field">
              <span>I am registering as a</span>
              <div class="mode-switch" style="width:100%;margin-top:8px">
                <button type="button" style="flex:1" class="mode-btn ${authRole === "client" ? "active" : ""}" data-act="setAuthRole" data-role="client">Client</button>
                <button type="button" style="flex:1" class="mode-btn ${authRole === "editor" ? "active" : ""}" data-act="setAuthRole" data-role="editor">Video Editor</button>
              </div>
            </div>

            <label class="field">Full Name
              <input name="name" required maxlength="60" placeholder="Your name or channel name">
            </label>

            ${authRole === "editor" ? `
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <label class="field">Starting Rate
                  <input name="pricing" required maxlength="35" placeholder="e.g., $35 / video">
                </label>
                <label class="field">Experience
                  <input name="experience" required maxlength="35" placeholder="e.g., 2 Years">
                </label>
              </div>
            ` : ""}
          ` : ""}

          <label class="field">Email
            <input name="email" type="email" required placeholder="you@example.com">
          </label>

          <label class="field">Password
            <input name="password" type="password" required minlength="4" placeholder="At least 4 characters">
          </label>

          <button type="submit" class="btn primary" style="width:100%">
            ${authMode === "in" ? "SIGN IN" : `REGISTER AS ${authRole.toUpperCase()}`}
          </button>
        </form>

        <p style="margin-top:16px;font-size:.9rem;color:var(--muted);text-align:center">
          ${authMode === "in"
            ? `New to EditConnect? <a href="#" style="color:var(--cyan)" data-act="toggleAuthMode">Create an account</a>`
            : `Already registered? <a href="#" style="color:var(--cyan)" data-act="toggleAuthMode">Sign in</a>`}
        </p>

        <div style="margin-top:22px;padding-top:18px;border-top:1px solid var(--line)">
          <p class="muted" style="font-size:.82rem;text-align:center;margin-bottom:10px">Or test immediately with pre-loaded accounts:</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <button type="button" class="btn small" data-act="demoLogin" data-role="client">Demo Client</button>
            <button type="button" class="btn small" data-act="demoLogin" data-role="editor">Demo Editor</button>
          </div>
          <div style="text-align:center;margin-top:12px">
            <button type="button" class="btn small danger" data-act="resetDemo">Reset Demo Data</button>
          </div>
        </div>
      </div>
    </div>`;
  }
};

// ==========================================
// ACTIONS & FORM HANDLERS
// ==========================================
view.addEventListener("click", e => {
  const btn = e.target.closest("[data-act]");
  if (!btn) return;
  if (btn.tagName === "A") e.preventDefault();

  const act = btn.dataset.act;

  if (act === "setMode") {
    state.browseMode = btn.dataset.mode;
    saveState(state);
    render();
  }

  if (act === "setAuthRole") {
    authRole = btn.dataset.role;
    render();
  }

  if (act === "toggleAuthMode") {
    authMode = authMode === "in" ? "up" : "in";
    render();
  }

  if (act === "demoLogin") {
    const role = btn.dataset.role;
    const demoUser = state.users.find(u => u.role === role);
    if (demoUser) {
      state.currentUserId = demoUser.id;
      state.browseMode = role;
      saveState(state);
      toast(`Signed in as Demo ${role === "client" ? "Client" : "Editor"}: ${demoUser.name}`);
      location.hash = role === "client" ? "#/explore" : "#/studio";
    }
  }

  if (act === "resetDemo") {
    localStorage.removeItem(STORAGE_KEY);
    state = loadState();
    toast("Demo profiles and CONNECTS restored to defaults.");
    render();
  }

  if (act === "pickStar") {
    const val = Number(btn.dataset.val);
    const form = btn.closest("form");
    form.querySelector('[name="stars"]').value = val;
    btn.closest("[data-star-group]").querySelectorAll(".star-btn").forEach(b => {
      b.classList.toggle("active", Number(b.dataset.val) === val);
    });
  }

  if (act === "toggleBranch") {
    const u = currentUser();
    if (!u || u.role !== "editor") return;
    const b = btn.dataset.branch;
    u.branches = u.branches || [];
    if (u.branches.includes(b)) {
      u.branches = u.branches.filter(x => x !== b);
    } else {
      u.branches.push(b);
    }
    saveState(state);
    render();
  }

  if (act === "delPortfolio") {
    const u = currentUser();
    if (!u || u.role !== "editor") return;
    u.portfolio = (u.portfolio || []).filter(p => p.id !== btn.dataset.id);
    saveState(state);
    toast("Portfolio item removed.");
    render();
  }
});

view.addEventListener("input", e => {
  if (e.target.id === "searchInput") {
    searchTerm = e.target.value;
    const pos = e.target.selectionStart;
    render();
    const inp = $("#searchInput");
    if (inp) { inp.focus(); inp.setSelectionRange(pos, pos); }
  }
});

view.addEventListener("change", e => {
  if (e.target.id === "branchSelect") {
    branchFilter = e.target.value;
    render();
  }
  if (e.target.id === "sortSelect") {
    sortBy = e.target.value;
    render();
  }
});

view.addEventListener("submit", e => {
  e.preventDefault();
  const form = e.target;
  const type = form.dataset.form;
  const fd = Object.fromEntries(new FormData(form));

  if (type === "auth") {
    const email = (fd.email || "").trim().toLowerCase();
    const password = fd.password || "";

    if (authMode === "in") {
      const found = state.users.find(u => u.email.toLowerCase() === email && u.password === password);
      if (!found) {
        toast("Invalid email or password. Try Demo Client / Demo Editor below!");
        return;
      }
      state.currentUserId = found.id;
      state.browseMode = found.role;
      saveState(state);
      toast(`Welcome back, ${found.name}!`);
      location.hash = found.role === "client" ? "#/explore" : "#/studio";
    } else {
      if (state.users.some(u => u.email.toLowerCase() === email)) {
        toast("An account with this email already exists.");
        return;
      }
      const newUser = {
        id: "u_" + Date.now(),
        name: (fd.name || "").trim(),
        email,
        password,
        role: authRole,
        bio: "",
        ...(authRole === "editor" ? {
          pricing: (fd.pricing || "$30 / video").trim(),
          experience: (fd.experience || "1 Year").trim(),
          availability: "Available Now",
          branches: [],
          connects: 0,
          projectsCompleted: 0,
          portfolio: [],
          reviews: []
        } : {
          history: []
        })
      };
      state.users.push(newUser);
      state.currentUserId = newUser.id;
      state.browseMode = newUser.role;
      saveState(state);
      toast(`Account created as ${newUser.role === "client" ? "Client" : "Editor"}!`);
      location.hash = newUser.role === "client" ? "#/explore" : "#/studio";
    }
  }

  if (type === "rateEditor") {
    const u = currentUser();
    if (!u || u.role !== "client") {
      toast("Please sign in as a Client first.");
      return;
    }
    const ed = state.users.find(x => x.id === form.dataset.editorId);
    if (!ed) return;

    const projectConnects = Math.min(10, Math.max(0, Number(fd.projectConnects || 0)));
    const stars = Math.min(5, Math.max(0, Number(fd.stars || 0)));
    const starConnects = stars * 2;
    const totalAdded = projectConnects + starConnects;
    const projectTitle = (fd.projectTitle || "Completed Project").trim();

    ed.connects = (ed.connects || 0) + totalAdded;
    if (projectConnects > 0) {
      ed.projectsCompleted = (ed.projectsCompleted || 0) + 1;
    }
    ed.reviews = ed.reviews || [];
    ed.reviews.unshift({
      clientName: u.name,
      projectTitle,
      stars,
      projectConnects,
      starConnects,
      comment: (fd.comment || "").trim()
    });

    u.history = u.history || [];
    u.history.unshift({
      editorName: ed.name,
      projectTitle,
      stars,
      connectsAwarded: totalAdded
    });

    saveState(state);
    toast(`Awarded +${totalAdded} CONNECTS to ${ed.name} (${projectConnects} project + ${starConnects} stars)!`);
    render();
  }

  if (type === "addPortfolio") {
    const u = currentUser();
    if (!u || u.role !== "editor") return;
    const branch = (fd.branch || "").trim();
    const item = {
      id: "port_" + Date.now(),
      title: (fd.title || "").trim(),
      branch,
      url: (fd.url || "").trim(),
      notes: (fd.notes || "").trim()
    };
    u.portfolio = u.portfolio || [];
    u.portfolio.unshift(item);

    // Automatically represent portfolio branch in editor's branch tags
    u.branches = u.branches || [];
    if (branch && !u.branches.includes(branch)) {
      u.branches.push(branch);
    }

    saveState(state);
    toast(`Portfolio added & tagged under #${branch}!`);
    render();
  }

  if (type === "saveEditorProfile") {
    const u = currentUser();
    if (!u || u.role !== "editor") return;
    u.name = (fd.name || u.name).trim();
    u.pricing = (fd.pricing || "").trim();
    u.experience = (fd.experience || "").trim();
    u.availability = fd.availability || "Available Now";
    u.bio = (fd.bio || "").trim();
    saveState(state);
    toast("Editor profile saved!");
    render();
  }
});

// ==========================================
// ROUTER
// ==========================================
function render() {
  let route = location.hash.replace("#/", "").split("?")[0] || "home";

  if (route === "logout") {
    state.currentUserId = null;
    saveState(state);
    toast("Signed out.");
    location.hash = "#/home";
    return;
  }

  if (route === "join") {
    authMode = "up";
    route = "auth";
  }

  menu.classList.remove("open");
  burger.setAttribute("aria-expanded", "false");
  renderNav();

  const fn = Views[route] || Views.home;
  view.innerHTML = fn();
}

burger.addEventListener("click", () => {
  const open = menu.classList.toggle("open");
  burger.setAttribute("aria-expanded", String(open));
});

window.addEventListener("hashchange", () => {
  window.scrollTo(0, 0);
  render();
});

render();
</script>
</body>
</html>
